---
import Base from '../layouts/Base.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import FlatProject from '../components/sections/FlatProject.astro';
import FlatCta from '../components/sections/FlatCta.astro';
import {business} from '../lib/business';
---
<Base title="RubberBond Flat Roofing Leeds | WW Roofing & Building" description="RubberBond FleeceBack EPDM flat roofing specialists in Leeds. Flex-R Specialist Registered Installer for homes, extensions and commercial roofing projects.">
<SchemaLocalBusiness slot="head"/>
<section class="flat-hero"><img class="hero-image" src="/images/mount-st-mary-2.webp" width="1536" height="866" alt="RubberBond EPDM flat roof installed by WW at Mount St Mary, Leeds" fetchpriority="high"/><div class="hero-shade"></div><div class="wrap hero-inner"><p class="eyebrow">WW ROOFING & BUILDING · LEEDS</p><h1>Flat roofing.<br/><span>Specialist by design.</span></h1><p class="hero-description">RubberBond FleeceBack EPDM roofing, installed by your local Flex-R Specialist Registered Installer. From the roof over your home to your next development.</p><div class="hero-actions"><a class="button" href="/contact/">Discuss your flat roof <span aria-hidden="true">↗</span></a><a class="button button-ghost" href={business.phoneHref}>Call {business.phone}</a></div><a class="hero-caption" href="/projects/mount-st-mary/"><span class="caption-square">↗</span><span>OUR WORK · MOUNT ST MARY, LEEDS<br/><strong>953 m² of RubberBond flat roofing</strong></span></a></div></section>
<div class="credential-strip"><div class="wrap"><img src="/images/flex-r.png" alt="Flex-R" width="150" height="43"/><div><strong>Specialist Registered Installer</strong><span>Product-specific training. Technical support.</span></div><div><strong>RubberBond FleeceBack EPDM</strong><span>A specialist system for flat and low-slope roofs.</span></div><a href="/about/#specialist-installer">What it means for you ↗</a></div></div>
<section class="section"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Your roof. Our specialism.</p><h2>Small extension.<br/>Big development.<br/>The same attention to detail.</h2></div><p>Good flat roofing starts with the whole roof: the deck, insulation, drainage and every edge. We assess your property and build the specification around it, using RubberBond FleeceBack EPDM as our specialist flat roofing system.</p></div><div class="audience-grid"><a class="audience-card" href="/sectors/residential/"><span class="card-number">01 / FOR YOUR HOME</span><h3>A better roof over<br/>the space you love.</h3><p>Flat roof replacements, extensions, dormers and garages. Clear advice on what your roof needs and how the work will be carried out.</p><span class="text-link">Residential flat roofing ↗</span></a><a class="audience-card dark-card" href="/sectors/commercial/"><span class="card-number">02 / FOR YOUR PROJECT</span><h3>Specialist roofing.<br/>Ready for the bigger picture.</h3><p>New builds, flats, schools and commercial property. Roofing packages for owners, managing agents, developers and main contractors.</p><span class="text-link">Commercial flat roofing ↗</span></a></div></div></section>
<FlatProject/>
<section class="section"><div class="wrap system-grid"><div><p class="eyebrow">The system we install</p><h2>RubberBond.<br/>More than a membrane.</h2><p class="lead">Flexible EPDM waterproofing with a reinforcing fleece backing, installed as part of a considered roof build-up.</p><a class="text-link" href="/flat-roofing/">Get to know RubberBond ↗</a></div><div class="benefit-list"><article><span>01</span><div><h3>Built for exposure</h3><p>EPDM resists UV and ozone. Its flexibility helps it accommodate normal roof movement.</p></div></article><article><span>02</span><div><h3>Strength where it matters</h3><p>The fleece backing adds resistance to punctures. Compatible accessories complete corners, outlets and edges.</p></div></article><article><span>03</span><div><h3>A system suited to your roof</h3><p>Replacement, new build or a suitable overlay: we assess the existing construction before recommending an approach.</p></div></article></div></div></section>
<section class="other-band"><div class="wrap"><p class="eyebrow">Beyond flat roofing</p><h2>Roofing experience from eaves to ridge.</h2><p>We also undertake pitched roofing, slating, tiling, repairs, roof windows, leadwork and building work.</p><div class="other-links"><a href="/services/">Explore other roofing services ↗</a><a href="/construction/">Extensions & building work ↗</a></div></div></section>
<section class="section"><div class="wrap section-intro"><div><p class="eyebrow">Local to you</p><h2>Crossgates roots.<br/>Across Leeds.</h2></div><div><p>Serving Leeds and surrounding areas, including Garforth, Roundhay, Wetherby, Horsforth and Selby. Share your postcode and we can discuss your project.</p><a class="text-link" href="/areas/">See the areas we cover ↗</a></div></div></section><FlatCta/>
</Base>
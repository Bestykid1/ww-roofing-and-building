---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import HeroText from '../../components/hero/HeroText.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { areasServed, business } from '../../lib/business';

const areaPages = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const dedicated = new Set(areaPages.map((a) => a.id));
const otherAreas = areasServed.filter(
  (a) => !dedicated.has(a.toLowerCase().replaceAll(' ', '-')),
);
---

<Base
  title="Flat Roofing Across Yorkshire & Beyond | WW Roofing"
  description="RubberBond flat roofing across Yorkshire and beyond. Other roofing and building work generally covers Leeds and surrounding areas. Based in Crossgates."
>
  <HeroText
    kicker="Coverage"
    heading="Areas we cover"
    lede={`WW Roofing & Building is based in ${business.baseLocality}. We welcome RubberBond flat roofing projects across Yorkshire and beyond. Other roofing and building work generally covers Leeds and surrounding areas.`}
  />

  <div class="wrap" style="padding-block-start: var(--space-4)">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Areas' }]} />
  </div>

  <section class="section-tight">
    <div class="wrap areas-layout">
      <div class="prose">
        <h2>RubberBond flat roofing: Yorkshire and beyond</h2><p>We install <a href="/flat-roofing/">RubberBond FleeceBack EPDM flat roofing</a> for homes, extensions and commercial projects throughout Yorkshire, and are happy to discuss work further afield. Send your postcode, roof details and programme so we can plan the assessment and installation.</p><h2>Other roofing and building work: Leeds and surrounding areas</h2><p>Our pitched roofing, repairs, slating, tiling, roof windows, leadwork and building work generally serve Leeds and the surrounding towns and villages. The local areas listed here relate to that work; they do not limit our RubberBond flat roofing coverage.</p><h2>Quoting is the same everywhere</h2>
        <p>
          We visit, measure, and look at the roof itself rather than pricing from the
          kerb. You get a written price that says what is included, and if anything can
          only be known once work starts, it is flagged and priced as a rate up front.
        </p>
      </div>

      <aside>
        <h2 class="areas-side-head">Local area pages</h2>
        <ul class="areas-links">
          {areaPages.map((a) => (
            <li><a href={`/areas/${a.id}/`}>{a.data.title}</a></li>
          ))}
        </ul>
        <h2 class="areas-side-head">Other local areas</h2>
        <ul class="areas-plain">
          {otherAreas.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <CtaBand
    title="Planning a roof outside Leeds?"
    note="We welcome RubberBond flat roofing enquiries across Yorkshire and beyond. Tell us where your project is."
  />
</Base>

<style>
  .areas-layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(240px, 4fr);
    gap: var(--space-6);
  }

  .areas-side-head {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-block: var(--space-4) var(--space-2);
    border-top: 2px solid var(--surface-slate);
    padding-block-start: var(--space-3);
  }

  .areas-side-head:first-child {
    margin-block-start: 0;
  }

  .areas-links,
  .areas-plain {
    list-style: none;
    padding: 0;
  }

  .areas-links li {
    padding-block: 0.4rem;
  }

  .areas-links a {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .areas-plain {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem var(--space-3);
    color: var(--ink-soft);
    font-size: var(--text-s);
  }

  @media (max-width: 800px) {
    .areas-layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

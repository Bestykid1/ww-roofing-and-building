---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import HeroText from '../../components/hero/HeroText.astro';
import Photo from '../../components/media/Photo.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { business } from '../../lib/business';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
}

const { area } = Astro.props;
const { Content } = await render(area);
const data = area.data;

const emphasis = await Promise.all(data.serviceEmphasis.map((ref) => getEntry('services', ref.id)));
const sidePhoto = data.sidePhoto ? await getEntry('photos', data.sidePhoto.id) : undefined;
---

<Base title={data.metaTitle} description={data.metaDescription}>
  <HeroText kicker="Areas we cover" heading={data.title} lede={data.propertyStockNote} />

  <div class="wrap" style="padding-block-start: var(--space-4)">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Areas', href: '/areas/' },
        { label: data.title },
      ]}
    />
  </div>

  <section class="section-tight">
    <div class="wrap area-layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="area-aside">
        {sidePhoto && (
          <figure class="area-photo">
            <Photo
              slug={sidePhoto.data.slug}
              role="grid"
              sizes="(max-width: 800px) 100vw, 32vw"
              altOverride=""
            />
            <figcaption>From our work: {sidePhoto.data.alt.toLowerCase()}</figcaption>
          </figure>
        )}
        <h2 class="area-side-head">Most requested here</h2>
        <ul class="area-services">
          {emphasis.filter(Boolean).map((s) => (
            <li>
              <a href={`/services/${s!.id}/`}>{s!.data.title}</a>
              <p>{s!.data.intro.split('. ')[0]}.</p>
            </li>
          ))}
        </ul>
        <h2 class="area-side-head">Talk to us</h2>
        <p class="area-phone">
          <a class="phone-link" href={business.phoneHref}>{business.phone}</a>
        </p>
      </aside>
    </div>
  </section>

  <CtaBand
    title={`Roof trouble in ${data.title.replace(/^Roofers in /, '')}?`}
    note="Send a few details and we will come back with an honest assessment and a clear written price."
  />
</Base>

<style>
  .area-layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(240px, 4fr);
    gap: var(--space-6);
  }

  .area-aside {
    position: sticky;
    top: var(--space-4);
    align-self: start;
  }

  .area-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .area-photo figcaption {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    padding-block: 0.5rem var(--space-3);
  }

  .area-side-head {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-block: var(--space-4) var(--space-2);
    border-top: 2px solid var(--surface-slate);
    padding-block-start: var(--space-3);
  }

  .area-side-head:first-child {
    margin-block-start: 0;
  }

  .area-services {
    list-style: none;
    padding: 0;
  }

  .area-services li {
    padding-block: var(--space-2);
  }

  .area-services a {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .area-services p {
    font-size: var(--text-s);
    color: var(--ink-soft);
    margin-block-start: 0.2rem;
  }

  @media (max-width: 800px) {
    .area-layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

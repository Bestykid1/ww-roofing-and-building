---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import HeroText from '../../components/hero/HeroText.astro';
import Photo from '../../components/media/Photo.astro';
import CtaBand from '../../components/sections/CtaBand.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Our Work | Roofing Projects in Leeds | WW Roofing"
  description="A record of WW Roofing & Building's work: re-roofs, heritage stone slate, tiling, rooflights and construction projects photographed from the scaffold."
>
  <HeroText
    kicker="Our work"
    heading="The work is the evidence"
    lede="Every photograph here is one of our jobs, taken by the people who did the work. In-progress shots included deliberately: what a roof looks like half way through tells you more about a contractor than any finished glamour shot."
  />

  <div class="wrap" style="padding-block-start: var(--space-4)">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Our work' }]} />
  </div>

  <section class="section-tight">
    <div class="wrap-wide project-archive">
      {projects.map((project) => {
        const hasPage = project.data.photos.length > 1;
        const Tag = hasPage ? 'a' : 'div';
        return (
          <Tag
            class:list={['pa-item', { wide: project.data.featured, linked: hasPage }]}
            {...(hasPage ? { href: `/projects/${project.id}/` } : {})}
          >
            <div class="pa-media">
              <Photo
                slug={project.data.photos[0].id}
                role={project.data.featured ? 'hero' : 'grid'}
                sizes={project.data.featured ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 900px) 100vw, 30vw'}
                altOverride=""
              />
            </div>
            <div class="pa-caption">
              <span class="pa-meta">{project.data.category}</span>
              <span class="pa-title">{project.data.title}</span>
              <span class="pa-summary">{project.data.summary}</span>
              {hasPage && <span class="pa-more">View this project &rarr;</span>}
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <CtaBand
    title="Want your roof to look like this?"
    note="Tell us about the job and we will tell you honestly how we would approach it."
  />
</Base>

<style>
  .project-archive {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-5) var(--space-4);
    align-items: start;
  }

  .pa-item {
    grid-column: span 4;
    text-decoration: none;
    color: inherit;
  }

  .pa-item.wide {
    grid-column: span 8;
  }

  .pa-media {
    overflow: hidden;
  }

  .pa-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .pa-item.wide .pa-media :global(img) {
    aspect-ratio: 16 / 9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pa-item:hover .pa-media :global(img) {
      transform: scale(1.02);
    }
  }

  .pa-caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .pa-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-m);
  }

  .pa-item.linked:hover .pa-title {
    color: var(--accent);
  }

  .pa-meta {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pa-summary {
    font-size: var(--text-s);
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .pa-more {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-block-start: 0.35rem;
  }

  .pa-item.linked:hover .pa-more {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .pa-item,
    .pa-item.wide {
      grid-column: 1 / -1;
    }
  }
</style>

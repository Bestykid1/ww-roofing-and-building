---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import Photo from '../../components/media/Photo.astro';
import CtaBand from '../../components/sections/CtaBand.astro';

export async function getStaticPaths() {
  // Single-photo jobs live as cards on the index only; a dedicated page needs
  // enough photography to earn its URL.
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.photos.length > 1)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const data = project.data;
const { Content } = await render(project);

const photos = await Promise.all(data.photos.map((ref) => getEntry('photos', ref.id)));
const services = await Promise.all(data.services.map((ref) => getEntry('services', ref.id)));
const [lead, ...rest] = photos.filter(Boolean);
---

<Base
  title={`${data.title} | Our Work | WW Roofing`}
  description={data.summary}
>
  <article>
    <header class="wrap project-head">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Our work', href: '/projects/' },
          { label: data.title },
        ]}
      />
      <p class="kicker" style="margin-top: var(--space-4)">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="project-summary">{data.summary}</p>
      <div class="project-services">
        {services.filter(Boolean).map((s) => (
          <a href={`/services/${s!.id}/`}>{s!.data.title}</a>
        ))}
      </div>
    </header>

    {lead && (
      <figure class="wrap-wide project-lead">
        <Photo
          slug={lead.data.slug}
          role={lead.data.orientation === 'landscape' ? 'hero' : 'grid'}
          sizes="(max-width: 900px) 100vw, 90vw"
          loading="eager"
        />
        <figcaption>{lead.data.alt}</figcaption>
      </figure>
    )}

    {rest.length > 0 && (
      <div class="wrap-wide project-grid">
        {rest.map((p) => (
          <figure class:list={['pg-item', p!.data.orientation]}>
            <Photo
              slug={p!.data.slug}
              role="grid"
              sizes="(max-width: 900px) 100vw, 44vw"
            />
            <figcaption>{p!.data.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="wrap prose project-body">
      <Content />
    </div>
  </article>

  <CtaBand
    title="A similar job in mind?"
    note="Tell us what the building needs and we will tell you how we would do it, and what it would cost."
  />
</Base>

<style>
  .project-head {
    padding-block: var(--space-5) var(--space-4);
  }

  .project-head h1 {
    max-width: 20ch;
  }

  .project-summary {
    margin-block-start: var(--space-3);
    font-size: var(--text-l);
    color: var(--ink-soft);
    max-width: 50ch;
  }

  .project-services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  .project-services a {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--timber);
    padding-bottom: 2px;
  }

  .project-services a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .project-lead :global(img) {
    width: 100%;
    max-height: 72vh;
    object-fit: cover;
  }

  .project-lead figcaption,
  .project-grid figcaption {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    padding-block-start: 0.5rem;
    max-width: 60ch;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
    align-items: start;
  }

  /* A trailing odd image spans the full row rather than leaving a void. */
  .project-grid > .pg-item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .project-grid > .pg-item.landscape:last-child:nth-child(odd) :global(img) {
    aspect-ratio: 16 / 9;
  }

  .pg-item.portrait :global(img) {
    aspect-ratio: 3 / 4;
    width: 100%;
    object-fit: cover;
  }

  .pg-item.landscape :global(img) {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }

  .project-body {
    padding-block: var(--space-5) var(--space-section);
  }

  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

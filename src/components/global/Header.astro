---
import { business } from '../../lib/business';
const nav=[['Flat roofing','/flat-roofing/'],['Our projects','/projects/'],['About WW','/about/'],['Other services','/services/'],['Areas','/areas/']];
---
<div class="topline"><div class="wrap-wide"><span>RubberBond flat roofing specialists · Leeds & surrounding areas</span><a href={business.phoneHref}>Call Andy · {business.phone}</a></div></div>
<header class="ww-header"><div class="wrap-wide ww-nav"><a class="ww-brand" href="/" aria-label="WW Roofing & Building home"><img src="/images/ww-logo.png" width="156" height="105" alt="WW Roofing"/><span>ROOFING & BUILDING<br/><small>CROSSGATES · LEEDS</small></span></a><nav aria-label="Main" class="ww-links">{nav.map(([label,href])=><a href={href} aria-current={Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}</nav><a class="button" href="/contact/">Request a quote <span aria-hidden="true">↗</span></a><details class="ww-mobile"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile">{nav.map(([label,href])=><a href={href}>{label}</a>)}<a href="/contact/">Request a quote</a><a href={business.phoneHref}>{business.phone}</a></nav></details></div></header>
<script>const menu=document.querySelector('.ww-mobile');document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu instanceof HTMLDetailsElement){menu.open=false;menu.querySelector('summary')?.focus()}});</script>
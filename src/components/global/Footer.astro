---
import { Image } from 'astro:assets';
import { areasServed, business } from '../../lib/business';
import CourseLines from '../craft/CourseLines.astro';
import mark from '../../assets/logo/mark.png';

const year = new Date().getFullYear();

const serviceLinks = [
  { label: 'Re-roofing', href: '/services/re-roofing/' },
  { label: 'Slating', href: '/services/slating/' },
  { label: 'Tiling', href: '/services/tiling/' },
  { label: 'Roof repairs', href: '/services/roof-repairs/' },
  { label: 'Velux & roof windows', href: '/services/velux-roof-windows/' },
  { label: 'Leadwork & roofline', href: '/services/leadwork-and-roofline/' },
];

const companyLinks = [
  { label: 'About WW', href: '/about/' },
  { label: 'Our work', href: '/projects/' },
  { label: 'Extensions & new builds', href: '/construction/' },
  { label: 'For construction partners', href: '/sectors/construction-partners/' },
  { label: 'Areas we cover', href: '/areas/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="site-footer on-dark">
  <div class="footer-edge" aria-hidden="true">
    <CourseLines class="footer-course" />
    <CourseLines class="footer-course" />
    <CourseLines class="footer-course" />
  </div>

  <div class="wrap-wide footer-grid">
    <div class="footer-brand">
      <div class="footer-mark-row">
        <Image src={mark} alt="" width="64" densities={[1, 2]} class="footer-mark" />
        <p class="footer-name">WW Roofing &amp; Building</p>
      </div>
      <p class="footer-statement">
        Roofing and building contractors working across {business.serviceAreaSummary}, from
        roof repairs and full re-roofs to extensions and new builds.
      </p>
      <p class="footer-contact">
        <a href={business.phoneHref}>{business.phone}</a><br />
        <a href={business.emailHref}>{business.email}</a>
      </p>
    </div>

    <nav class="footer-col" aria-label="Services">
      <h2>Roofing</h2>
      <ul>
        {serviceLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        {companyLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-areas">
      <h2>Areas we cover</h2>
      <p>
        {areasServed.join(' / ')} -
        <a href="/areas/">full coverage details</a>
      </p>
    </div>
  </div>

  <div class="wrap-wide footer-legal">
    <p>&copy; {year} {business.legalName}. All rights reserved.</p>
    <ul>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><a href={business.facebook} rel="noopener">Facebook</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-slate-deep);
    color: var(--ink-on-dark);
    margin-block-start: 0;
  }

  .footer-edge {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    overflow: hidden;
    padding: var(--space-4) var(--gutter) 0;
    color: var(--line-on-dark);
  }

  .footer-course {
    flex-shrink: 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(240px, 1.4fr) 1fr 1fr 1.2fr;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-6);
  }

  .footer-mark-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .footer-mark {
    mix-blend-mode: screen;
    height: 2.1rem;
    width: auto;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-m);
  }

  .footer-statement {
    margin-block-start: var(--space-3);
    color: var(--ink-on-dark-soft);
    font-size: var(--text-s);
  }

  .footer-contact {
    margin-block-start: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-s);
    line-height: 2;
  }

  .footer-contact a {
    text-decoration: none;
  }

  .footer-contact a:hover {
    color: var(--accent-bright);
  }

  .footer-col h2 {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-on-dark-soft);
    margin-block-end: var(--space-3);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col a {
    text-decoration: none;
    font-size: var(--text-s);
  }

  .footer-col a:hover {
    color: var(--accent-bright);
  }

  .footer-areas p {
    font-size: var(--text-s);
    color: var(--ink-on-dark-soft);
    line-height: 1.9;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--text-xs);
    color: var(--ink-on-dark-soft);
  }

  .footer-legal ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .footer-legal a {
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: var(--ink-on-dark);
  }

  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .footer-edge {
      justify-content: flex-start;
    }

    .footer-edge :global(svg:nth-child(n + 2)) {
      display: none;
    }
  }
</style>

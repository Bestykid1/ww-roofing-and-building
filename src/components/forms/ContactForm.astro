---
import { areasServed } from '../../lib/business';

const enquiryTypes = [
  'RubberBond flat roof replacement',
  'New flat roof / extension / dormer',
  'Commercial flat roofing package',
  'Roof repair',
  'Re-roof or new roof',
  'Slating or tiling',
  'Velux / roof windows',
  'Leadwork, fascias or guttering',
  'Extension or building work',
  'Main contractor / subcontract enquiry',
  'Something else',
];
---

<form
  class="contact-form"
  name="contact"
  method="POST"
  action="/contact/"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hp-field" aria-hidden="true">
    <label>
      Leave this field empty
      <input name="company-website" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="cf-row">
    <div class="cf-field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="cf-field">
      <label for="cf-phone">Phone</label>
      <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" />
    </div>
  </div>

  <div class="cf-row">
    <div class="cf-field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="cf-field">
      <label for="cf-area">Area</label>
      <select id="cf-area" name="area">
        <option value="">Choose an area (optional)</option>
        {areasServed.map((a) => (
          <option value={a}>{a}</option>
        ))}
        <option value="Other">Somewhere else</option>
      </select>
    </div>
  </div>

  <div class="cf-field">
    <label for="cf-type">What does the job involve?</label>
    <select id="cf-type" name="enquiry-type" required>
      <option value="">Choose the closest match</option>
      {enquiryTypes.map((t) => (
        <option value={t}>{t}</option>
      ))}
    </select>
  </div>

  <div class="cf-field">
    <label for="cf-message">Tell us about it</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      maxlength="1500"
      required
      placeholder="What is happening with the roof or building, roughly how old the property is, and anything else useful."></textarea>
  </div>

  <p class="cf-note">
    Include your postcode, approximate roof size and timing requirements. You can attach photographs to the email before sending.
  </p>

  <button class="btn btn-primary" type="submit">Prepare email enquiry</button>
  <p class="cf-after">
    This opens your email app with your enquiry. Review it, attach photos and press Send there. Preparing an email does not send it.
  </p>
<p id="email-status" role="status"></p><noscript><p>Please email <a href="mailto:info@wwroofingandbuilding.co.uk">info@wwroofingandbuilding.co.uk</a> or call 07565 301143.</p></noscript></form>

<style>
  .hp-field {
    position: absolute;
    left: -9999px;
    top: auto;
  }

  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .cf-field {
    margin-block-end: var(--space-3);
  }

  .cf-field label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-block-end: 0.4rem;
  }

  .cf-field input,
  .cf-field select,
  .cf-field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    background: #fff;
    font-family: var(--font-body);
    font-size: var(--text-m);
  }

  .cf-field textarea {
    resize: vertical;
  }

  .cf-field input:focus-visible,
  .cf-field select:focus-visible,
  .cf-field textarea:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .cf-note {
    font-size: var(--text-s);
    color: var(--ink-soft);
    margin-block-end: var(--space-4);
    max-width: 56ch;
  }

  .cf-after {
    margin-block-start: var(--space-3);
    font-size: var(--text-s);
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .cf-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
const form=document.querySelector('.contact-form');
form?.addEventListener('submit',event=>{event.preventDefault();if(!(form instanceof HTMLFormElement)||!form.reportValidity())return;const d=new FormData(form);const body=['Name: '+d.get('name'),'Phone: '+d.get('phone'),'Email: '+d.get('email'),'Area: '+d.get('area'),'','Project: '+d.get('enquiry-type'),'',''+d.get('message')].join('\n');window.location.href='mailto:info@wwroofingandbuilding.co.uk?subject='+encodeURIComponent('Roofing enquiry: '+d.get('enquiry-type'))+'&body='+encodeURIComponent(body);const status=document.getElementById('email-status');if(status)status.textContent='Your email app has been requested. Your enquiry has not been sent by this website. If it does not open, email info@wwroofingandbuilding.co.uk or call 07565 301143.';});
</script>
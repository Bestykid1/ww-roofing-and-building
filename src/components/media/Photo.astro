---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';

interface Props {
  slug: string;
  /** Crop variant suffix from the photo manifest, e.g. "hero", "clean". */
  variant?: string;
  /** Overrides the role stored in photos.json for width selection. */
  role?: 'hero' | 'grid' | 'detail';
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  /** Pass "" for decorative use; otherwise alt comes from photos.json. */
  altOverride?: string;
}

const { slug, variant, role, sizes, loading = 'lazy', class: className, altOverride } = Astro.props;

const record = await getEntry('photos', slug);
if (!record) throw new Error(`Photo record missing in photos.json: ${slug}`);

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/photos/*.jpg',
  { eager: true },
);
const file = variant ? `${slug}--${variant}` : slug;
const mod = images[`../../assets/photos/${file}.jpg`];
if (!mod) throw new Error(`Photo asset missing: ${file}.jpg (check the manifest and re-run npm run photos)`);
const image = mod.default;

const ROLE_WIDTHS: Record<string, number[]> = {
  hero: [640, 960, 1280, 1600],
  grid: [400, 600, 800, 1000],
  detail: [320, 480, 640],
};
const effectiveRole = role ?? record.data.role;

// No-visible-upscaling guardrail: never request a width above ~1.5x native.
const cap = Math.floor(image.width * 1.5);
const widths = ROLE_WIDTHS[effectiveRole]
  .filter((w) => w <= cap)
  .map((w) => Math.min(w, image.width));
if (widths.length === 0) {
  throw new Error(
    `Photo ${file}.jpg (${image.width}px) is too small for role "${effectiveRole}"`,
  );
}

const alt = altOverride ?? record.data.alt;
---

<Picture
  src={image}
  formats={['avif', 'webp']}
  widths={[...new Set(widths)]}
  sizes={sizes}
  alt={alt}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={loading === 'eager' ? 'high' : 'auto'}
  class={className}
/>

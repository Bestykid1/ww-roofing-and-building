---
import { areasServed, business } from '../../lib/business';

/**
 * LocalBusiness JSON-LD for the homepage (rendered once per site).
 * Types validated against the live schema.org vocabulary and current Google
 * guidelines: RoofingContractor and GeneralContractor are both active
 * LocalBusiness subtypes, and Google supports multiple types as an array.
 * No aggregateRating, no openingHours until the client supplies real values.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['RoofingContractor', 'GeneralContractor'],
  name: business.name,
  url: Astro.site?.toString(),
  image: new URL('/og-default.jpg', Astro.site).toString(),
  telephone: business.phone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Leeds',
    addressRegion: 'West Yorkshire',
    addressCountry: 'GB',
  },
  areaServed: areasServed.map((a) => ({ '@type': 'Place', name: `${a}, Leeds` })),
  sameAs: [business.facebook],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

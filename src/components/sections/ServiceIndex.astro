---
import CourseLines from '../craft/CourseLines.astro';
import Photo from '../media/Photo.astro';

interface Row {
  title: string;
  href: string;
  scope: string;
  photoSlug?: string;
  photoVariant?: string;
}

interface Props {
  kicker?: string;
  heading?: string;
  intro?: string;
  rows: Row[];
}

const {
  kicker = 'Roofing services',
  heading = 'What we do',
  intro,
  rows,
} = Astro.props;
---

<section class="service-index section">
  <div class="wrap">
    <div class="si-head">
      <div>
        <p class="kicker">{kicker}</p>
        <h2>{heading}</h2>
      </div>
      {intro && <p class="si-intro">{intro}</p>}
    </div>

    <ul class="si-rows">
      {rows.map((row) => (
        <li>
          <a class="si-row" href={row.href}>
            <span class="si-tick" aria-hidden="true"></span>
            <span class="si-title">{row.title}</span>
            <span class="si-scope">{row.scope}</span>
            {row.photoSlug ? (
              <span class="si-thumb">
                <Photo
                  slug={row.photoSlug}
                  variant={row.photoVariant}
                  role="detail"
                  sizes="132px"
                  altOverride=""
                />
              </span>
            ) : (
              <span class="si-thumb si-thumb-motif" aria-hidden="true">
                <CourseLines width={92} />
              </span>
            )}
            <span class="si-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .si-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-end: var(--space-5);
  }

  .si-intro {
    color: var(--ink-soft);
    max-width: 44ch;
    font-size: var(--text-m);
  }

  .si-rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .si-rows li {
    max-width: none;
  }

  .si-row {
    display: grid;
    grid-template-columns: 2rem minmax(180px, 1.1fr) 2fr 132px 2.5rem;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .si-tick {
    width: 1.4rem;
    height: 2px;
    background: var(--timber);
    transition: width 130ms ease, background-color 130ms ease;
  }

  .si-row:hover .si-tick {
    width: 2rem;
    background: var(--accent);
  }

  .si-title {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-weight: 700;
    line-height: 1.15;
  }

  .si-scope {
    color: var(--ink-soft);
    font-size: var(--text-s);
    max-width: 44ch;
  }

  .si-thumb {
    height: 76px;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .si-thumb :global(img) {
    width: 100%;
    height: 76px;
    object-fit: cover;
  }

  .si-thumb-motif {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76px;
    background: var(--surface-stone);
    color: var(--timber);
  }

  .si-arrow {
    font-size: var(--text-l);
    color: var(--line-strong);
    text-align: end;
    transition: color 130ms ease, transform 130ms ease;
  }

  .si-row:hover .si-title {
    color: var(--accent);
  }

  .si-row:hover .si-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .si-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .si-row {
      grid-template-columns: 1.6rem 1fr 2rem;
    }

    .si-scope,
    .si-thumb {
      display: none;
    }
  }
</style>

---
import WorkPhoto from '../media/WorkPhoto.astro';
const {service}=Astro.props;
const lead=service==='leadwork-and-roofline';const slate=service==='slating';const tiled=['tiling','re-roofing','velux-roof-windows'].includes(service);
---
{(lead||slate||tiled)&&<section class="section" id={lead?'our-leadwork':'our-work'}><div class="wrap editorial"><p class="eyebrow">Photographs of our work</p><h2>{lead?'Leadwork at the bench':slate?'Slate roofing at Mount St Mary’s Church':'Tiled roofing and roof windows'}</h2><p>{lead?'Our own photographs show lead being formed and welded at the workbench, before it becomes part of a roof detail.':slate?'A closer view of the slate courses and junctions on our church roofing work.':'See the tile courses, roof windows and verge finish in photographs taken from the scaffold.'}</p><div class="project-gallery">{lead?<><WorkPhoto id="lead-welding" caption="Welding a formed lead detail."/><WorkPhoto id="formed-lead-detail" caption="A formed lead component and the tools used at the bench."/></>:slate?<><WorkPhoto id="church-slate-roof" caption="The church slate roof from scaffold level."/><WorkPhoto id="church-slate-junctions" caption="Slate courses and roof junctions."/></>:<><WorkPhoto id="tiled-roof-windows" caption="Roof windows within the tiled slope."/><WorkPhoto id="tiled-roof-verge" caption="The finish at the gable verge."/></>}</div>{!lead&&<a class="text-link" href={slate?'/projects/mount-st-mary/#slate-roofing':'/projects/tiled-roof-and-roof-windows/'}>View the project photographs ↗</a>}</div></section>}

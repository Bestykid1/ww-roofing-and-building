---
import Photo from '../media/Photo.astro';

interface Item {
  href: string;
  title: string;
  meta: string;
  photoSlug: string;
  photoVariant?: string;
  /** the lead item renders larger */
  lead?: boolean;
}

interface Props {
  kicker?: string;
  heading?: string;
  items: Item[];
  moreHref?: string;
  moreLabel?: string;
}

const {
  kicker = 'Our work',
  heading = 'Recent projects',
  items,
  moreHref = '/projects/',
  moreLabel = 'Browse all our work',
} = Astro.props;
---

<section class="project-strip section">
  <div class="wrap-wide">
    <div class="ps-head">
      <div>
        <p class="kicker">{kicker}</p>
        <h2>{heading}</h2>
      </div>
      <a class="btn btn-outline" href={moreHref}>{moreLabel}</a>
    </div>

    <div class="ps-grid">
      {items.map((item) => (
        <a class:list={['ps-item', { lead: item.lead }]} href={item.href}>
          <div class="ps-media">
            <Photo
              slug={item.photoSlug}
              variant={item.photoVariant}
              role={item.lead ? 'hero' : 'grid'}
              sizes={item.lead ? '(max-width: 900px) 100vw, 56vw' : '(max-width: 900px) 100vw, 28vw'}
              altOverride=""
            />
          </div>
          <div class="ps-caption">
            <span class="ps-title">{item.title}</span>
            <span class="ps-meta">{item.meta}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ps-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-end: var(--space-5);
    flex-wrap: wrap;
  }

  .ps-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .ps-item {
    text-decoration: none;
    color: inherit;
    grid-column: span 4;
    display: block;
  }

  .ps-item.lead {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ps-media {
    overflow: hidden;
  }

  .ps-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .ps-item.lead .ps-media :global(img) {
    aspect-ratio: 16 / 10;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ps-item:hover .ps-media :global(img) {
      transform: scale(1.025);
    }
  }

  .ps-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    border-bottom: 1px solid var(--line);
    padding-block: 0.7rem;
  }

  .ps-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-m);
  }

  .ps-item:hover .ps-title {
    color: var(--accent);
  }

  .ps-meta {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .ps-item,
    .ps-item.lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
